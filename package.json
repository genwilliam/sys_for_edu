{
  "name": "sys-for-edu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sys-for-edu/frontend dev",
    "build": "pnpm --filter @sys-for-edu/frontend build",
    "lint": "pnpm --filter @sys-for-edu/frontend lint",
    "type-check": "pnpm --filter @sys-for-edu/frontend type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backend:test": "cd backend && ./mvnw test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "prettier": "3.9.6"
  }
}
